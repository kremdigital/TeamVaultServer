# Caddy configuration for Obsidian Team.
#
# This file is templated by `scripts/install.sh`: ${DOMAIN}, ${EXTRA_DOMAINS},
# ${PORT_WEB} and ${PORT_SOCKET} are substituted via `envsubst` before the file
# is copied to /etc/caddy/Caddyfile.
#
# ${EXTRA_DOMAINS} — mirror hostnames served by the SAME site block, each
# preceded by a comma (e.g. `, teamvault.example.com`). Empty by default. Caddy
# issues a certificate per hostname, so every one of them must already resolve
# to this server. Sessions are NOT shared across hostnames: cookies are
# host-scoped, so a user signs in on each domain separately.
#
# The `{remote_host}` placeholders below are *Caddy* placeholders (resolved at
# request time) — they intentionally pass through envsubst unchanged because
# envsubst only expands `$VAR` / `${VAR}`.

${DOMAIN}${EXTRA_DOMAINS} {
    encode gzip zstd

    # Security headers, applied to every response of this site (both the web
    # process and the socket one). Set at the edge rather than in
    # `next.config.ts` so the socket endpoints are covered too.
    #
    # HSTS: one year, deliberately WITHOUT `preload`. It started at 30 days and
    # was raised once HTTPS (with Let's Encrypt renewals) had proven stable on
    # every hostname of this block. Preload is effectively irreversible for
    # months and needs a separate decision. Caddy already 308s plain HTTP to
    # HTTPS; HSTS makes browsers skip that plain-HTTP hop on later visits.
    # Browsers re-read max-age on every HTTPS response, so lowering it again
    # takes effect on a user's next visit. A mirror added to this site block
    # gets the same header: it must serve HTTPS from day one (Caddy does).
    #
    # Framing is denied twice on purpose: `frame-ancestors` is the modern rule,
    # `X-Frame-Options` covers clients that ignore it. Nothing legitimate
    # frames these pages: the app never embeds itself (note embeds `![[…]]`
    # render inline, not in an iframe), there are no public note pages, and
    # neither the Obsidian plugin nor the MCP server loads them in a frame.
    # With `SameSite=Lax` session cookies a cross-site frame would be logged
    # out anyway, so no embedding could have been relied on.
    #
    # The CSP intentionally carries *only* `frame-ancestors`. A script policy
    # for Next.js 16 needs a per-request nonce, which forces every page into
    # dynamic rendering (the prerendered /login, /register, /forgot-password
    # included), and inline <style> from sonner, CodeMirror and React style
    # attributes would still need `style-src 'unsafe-inline'`. That trade was
    # declined; notes are rendered without raw HTML (`skipHtml`).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }

    # Socket.IO traffic (websocket + long-polling) — proxy raw to the socket process.
    # Caddy auto-detects and upgrades the websocket connection.
    handle /socket.io/* {
        reverse_proxy localhost:${PORT_SOCKET}
    }

    # Everything else — Next.js web process.
    handle {
        reverse_proxy localhost:${PORT_WEB} {
            # Pass through the real client IP for our session/auth code.
            header_up X-Real-IP {remote_host}
        }
    }

    # Increase the body size for file uploads (default: 10MB). Adjust if you raise MAX_FILE_SIZE.
    request_body {
        max_size 50MB
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 14
        }
        format json
    }

    # # Optional: rate-limit auth endpoints. Requires Caddy built with
    # # the github.com/mholt/caddy-ratelimit plugin (xcaddy).
    # @auth path /api/auth/login /api/auth/register /api/auth/forgot-password
    # rate_limit @auth {
    #     zone auth_zone { key {remote_host} events 60 window 1m }
    # }
}
